# ---------------------------------------------------------------------------
# Backend environment variables (optional overrides)
# ---------------------------------------------------------------------------
# ASP.NET Core maps these onto the settings in appsettings.json using the
# double-underscore (__) convention. Setting them lets you keep real secrets
# OUT of appsettings.json. Copy relevant values into your shell / launch
# profile / user-secrets — do NOT commit real secrets.

# PostgreSQL connection string
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_management;Username=postgres;Password=CHANGE_ME

# JWT signing key (must be at least 32 characters). Generate a strong random value.
Jwt__Secret=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
Jwt__Issuer=AssignmentManagement
Jwt__Audience=AssignmentManagementClient
Jwt__ExpiryMinutes=480

# Comma / array CORS origins for the frontend
Cors__AllowedOrigins__0=http://localhost:3000

# Environment (Development enables Swagger UI and detailed logs)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
