{
  "//": "Copy this file to appsettings.Development.json and set your real PostgreSQL password.",
  "//_note": "appsettings.Development.json is gitignored so local credentials are never committed.",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=assignment_management;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
