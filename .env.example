# ===========================================================================
# Assignment & Submission Management System — environment variables
# ===========================================================================
# Copy the relevant sections into the appropriate place:
#   - Backend  -> environment variables / user-secrets / appsettings.*.json
#   - Frontend -> frontend/.env.local
# Never commit real passwords or secrets.

# ----------------------------- Backend (ASP.NET Core) ----------------------
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_management;Username=postgres;Password=CHANGE_ME
Jwt__Secret=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
Jwt__Issuer=AssignmentManagement
Jwt__Audience=AssignmentManagementClient
Jwt__ExpiryMinutes=480
Cors__AllowedOrigins__0=http://localhost:3000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# ----------------------------- Frontend (Next.js) --------------------------
# Place this one in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:5080/api
